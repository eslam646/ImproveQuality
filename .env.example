# ============ قاعدة البيانات ============
# sqlite (افتراضي — للتشغيل المحلي فوراً بدون أي إعداد) أو supabase
DB_DRIVER=sqlite
# عند الانتقال لـ Supabase (انظر README):
# DB_DRIVER=supabase
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============ المصادقة ============
# demo = دخول تجريبي باختيار الموظف | supabase = ماجيك لينك عبر Supabase Auth
AUTH_MODE=demo

# ============ الإيميلات ============
# بدون مفاتيح → وضع التسجيل (الإيميلات تظهر في "سجل البريد" ولا تُرسل فعلياً)
# BREVO_API_KEY=xkeysib-...
# RESEND_API_KEY=re_...
EMAIL_FROM_NAME=الدعم الفني
EMAIL_FROM_ADDRESS=support@yourdomain.com

# ============ عامل المهام والتذكيرات ============
WORKER_SECRET=dev-secret
APP_BASE_URL=http://localhost:3000
STALE_HOURS=24

# ============ Microsoft Teams (V2 — يُفعّل عند تنفيذ مرحلة الاجتماعات) ============
# تُحفظ القيم الحقيقية في Cloudflare Secrets ولا تُرفع إلى GitHub
# MS_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MS_CLIENT_SECRET=secret
# MS_ORGANIZER_USER_ID=user-guid-or-email
